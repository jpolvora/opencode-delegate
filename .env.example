# Optional: explicit OpenCode server URL. Leave empty to discover the registered
# local service (the same one `opencode` uses by default).
OPENCODE_SERVER_URL=

# Optional defaults. config.json is usually the better place for these.
# OPENCODE_DELEGATE_MODEL=opencode-go/deepseek-v4.1-flash
# OPENCODE_DELEGATE_AGENT=build
# OPENCODE_DELEGATE_AUTO_APPROVE=false
# OPENCODE_DELEGATE_TIMEOUT=3600
# OPENCODE_DELEGATE_RUN_DIR=
